{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // Layer 1 (mechanical) config. The research/orchestration layer lives in docs/upgrades/.
  // Renovate detects pins and opens bump PRs, the per-PR impact brief (docs/upgrades/RUNBOOK.md) decides what actually
  // merges.
  extends: [
    "config:best-practices",
    "config:js-lib",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    ":label(dependencies)",
    ":timezone(Europe/Tallinn)",
    "schedule:weekly",
    ":approveMajorUpdates",
  ],

  packageRules: [
    // --- regenerate both pnpm lockfiles after every npm update (INTERACTIONS §7) ---
    // fixture/ consumes this package as `file:..`, which Renovate skips, and its lockfile snapshots the root's
    // dependency tree — so a root-only bump leaves fixture/pnpm-lock.yaml stale and pnpm 12 fails the fixture job's
    // frozen install (`local dependency "@signmax/config" at ".." is outdated`, PR #57). The root re-run is a no-op
    // after a normal bump; on lockfile maintenance it is meant to restore the pnpm `packageManagerDependencies`
    // document that Renovate's own run has been dropping (PR #56, #59 — locally it does; unconfirmed under CE).
    // Both commands must match `allowedCommands` in the CE server config
    // (skyltmax/infra `terraform/main/renovate.tf`), else Renovate reports an artifact error on the PR.
    // installTools takes the latest pnpm; pnpm switches itself to the `packageManager` version.
    {
      matchManagers: ["npm"],
      postUpgradeTasks: {
        commands: [
          "pnpm install --lockfile-only --ignore-scripts --ignore-pnpmfile",
          "pnpm --dir fixture install --lockfile-only --ignore-scripts --ignore-pnpmfile",
        ],
        fileFilters: ["pnpm-lock.yaml", "fixture/pnpm-lock.yaml"],
        installTools: { node: {}, pnpm: {} },
        executionMode: "update",
      },
    },

    // --- ruby-version in the workflows stays at minor precision ---
    // `ruby-version: "4.0"` makes ruby/setup-ruby install the latest 4.0.x, so CI floats patches with the devcontainer
    // image instead of pinning one. Renovate would rewrite it to a full patch version (4.0 -> 4.0.6); disabling patch
    // updates keeps the float. Minors still PR — as a full version, since no versioning preserves 2-part precision for
    // this datasource — trim the proposed value back to X.Y on the branch (INTERACTIONS §9).
    {
      matchManagers: ["github-actions"],
      matchDepNames: ["ruby"],
      matchUpdateTypes: ["patch"],
      enabled: false,
    },

    // --- Harbor image: built in skyltmax/infra, tracked here ---
    // The CHANGELOG_DISPLAYED_<N> marker in .devcontainer/boot.sh still needs a manual commit on the PR, and a Ruby
    // change in the image needs the GEMS_ALREADY_RESET_<N> marker bumped too (INTERACTIONS §1). Tags carry
    // <upstream>-<N> rebuild suffixes, which docker versioning would misread as a compatibility suffix — regex
    // versioning treats <N> as a build counter, so rails-4.0.6-30 -> rails-4.0.6-31 is an update.
    {
      matchPackageNames: ["harbor.signmax.cloud/**"],
      groupName: "harbor images",
      addLabels: ["cross-repo/infra"],
      versioning: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<build>\\d+)$",
    },
    // The devcontainer image prefixes its tags with the stack name (devcontainer:rails-4.0.6-30).
    {
      matchPackageNames: ["harbor.signmax.cloud/public/devcontainer"],
      versioning: "regex:^rails-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<build>\\d+)$",
    },

    // --- abandonment flags we have already ruled on (INTERACTIONS §11) ---
    // The dashboard's abandoned list is release-inactivity detection, not a deprecation notice. These two were
    // reviewed and deliberately kept, so the flag is permanent noise that hides the next one; a long threshold mutes
    // them without muting the rest. Revisit by deleting the entry, not by editing the threshold.
    // `eslint-plugin-react` and `prettier-plugin-ignored` are gone from the roster entirely, so they cannot be flagged.
    {
      matchDatasources: ["npm"],
      matchPackageNames: ["eslint-plugin-jsx-a11y", "@total-typescript/ts-reset"],
      abandonmentThreshold: "10 years",
    },
  ],
}
